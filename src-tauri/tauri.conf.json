{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "lyfeos",
    "version": "0.1.0",
    "identifier": "com.yuri-luiz.lyfeos",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "lyfeos",
                "width": 800,
                "height": 600
            }
        ],
        "security": {
            "csp": null
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEMDZBRkRBQjQ2N0I3RDMKUldUVHQyZTAycThHWGZyZVE2ZENEWEJCbzFyam1zVkhiNVUzakttNE9hZ08ySEhhNWwybmFWa2QK",
            "endpoints": [
                "https://github.com/yuuhLKT/my-lyfeos/releases/latest/download/latest.json"
            ]
        },
        "sql": {
            "preload": ["sqlite:lyfeos.db"]
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
